 position: relative;"><div data-index="272" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26860px);"> </div><div data-index="273" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26877px);">/* ---------- prozori (dokaz i kod) i poruka ---------- */</div><div data-index="274" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26894px);">.zavesa { position: fixed; inset: 0; z-index: 60; background: rgba(0,6,2,.86); display: grid; place-items: center; padding: 20px; animation: fade .2s ease; }</div><div data-index="275" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26928px);">@keyframes fade { from { opacity: 0; } }</div><div data-index="276" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26945px);">.prozor { width: min(920px, 100%); max-height: calc(100% - 20px); overflow: auto; background: #04140a; border: 2px solid var(--green); box-shadow: 0 0 30px rgba(0,230,118,.3); animation: ulaz .3s cubic-bezier(.2,.7,.2,1); }</div><div data-index="277" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(26979px);">.prozor-vrh { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }</div><div data-index="278" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(27013px);">.prozor-vrh h3 { margin: 0; font-family: var(--display); font-weight: 400; font-style: italic; color: var(--green); font-size: 30px; letter-spacing: 2px; text-transform: uppercase; }</div><div data-index="279" style="position: absolute; top: 0px; left: 0px; width: 100%; transform: translateY(27047px);">.zatvori { background: transparent; border: 1px solid var(--line); width: 44px; height: 44px; color: var(--text); font-size: 20px; flex: none; }</div><div data-index="280" style="position: absolu